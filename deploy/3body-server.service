[Unit]
Description=3BODY Bun game server
After=network.target

[Service]
Type=simple
# Replace with the user/group and paths you actually deploy with.
User=samir
Group=samir
WorkingDirectory=/home/samir/3body
EnvironmentFile=-/home/samir/3body/3body.env
Environment=DATA_DIR=/home/samir/3body/data
Environment=HOST=127.0.0.1
Environment=PORT=8080
ExecStart=/home/samir/3body/bin/3body-server
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
